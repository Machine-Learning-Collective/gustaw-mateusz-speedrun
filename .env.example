# Copy to .env and fill in. Without OPENAI_API_KEY the app runs in demo mode.
OPENAI_API_KEY=

# Optional
# OPENAI_MODEL=gpt-5-mini
# LLM_PROVIDER=openai          # or "demo" to force demo mode even with a key
# LLM_TEMPERATURE=0.7          # ignored by models that only accept their default (GPT-5 family)
# LLM_TIMEOUT_SECONDS=60
